# PostgreSQL Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://carhunt:carhunt@localhost:5432/carhunt

# OpenRouter API key for LLM calls (deepseek-v4-flash for insights, query agent, normalization)
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key

# Dashboard HTTP Basic Auth (required by proxy.ts to secure web access)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=carhunt

# Optional: Residential proxy URL for heavy scraping (e.g. http://user:pass@host:port)
# PROXY_URL=

# Optional: Custom Python virtualenv and agents directory paths
# (Leave unset to automatically use agents/.venv/bin/python3)
# AGENTS_DIR=
# AGENTS_PYTHON=
